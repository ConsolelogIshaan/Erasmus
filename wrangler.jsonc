{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erasmus-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": { "binding": "VIDCORE_BROWSER", "remote": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_IS_CLOUDFLARE": "true",
    "NEXT_PUBLIC_HLS_RELAY_URL": "https://erasmus-hls-relay.erasmustv.workers.dev"
  },
  "services": [
    {
      "binding": "HLS_RELAY",
      "service": "erasmus-hls-relay"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RELAY_CONFIG",
      "id": "1b9f4e2fbdc74d6d943c64a37e9d0120"
    }
  ]
}
